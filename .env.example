# Copy to .env and fill in. Never commit .env. Never put these in client code (no NEXT_PUBLIC_ prefix).

# --- Core ---
DATABASE_URL=postgresql://tresor:tresor@localhost:5433/tresor
REDIS_URL=redis://localhost:6380
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Payments ---
# "razorpay" needs the three RAZORPAY_* values (test mode keys are fine). Anything else uses the
# local simulator, which is labelled as simulated everywhere and never moves money.
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Signs the simulator's webhooks so they take the same verification path as real ones.
SIMULATED_WEBHOOK_SECRET=

# --- Email (login codes, customer email) ---
# With RESEND_API_KEY set, email is sent through Resend. Without it, messages go to the
# development mailbox (/admin/dev-mailbox, development only) and the server log.
RESEND_API_KEY=
EMAIL_FROM="Tresor <no-reply@example.com>"

# --- WhatsApp ---
# No provider is wired yet; messages use the labelled simulator.

# --- Files ---
# Invoice PDFs and print artwork. Kept outside public/ and served through authorized routes.
STORAGE_DIR=./storage
