# Copy to .env.local (git-ignored) and fill in. On a host, set these as environment variables.
# Never prefix them with NEXT_PUBLIC_: they must stay on the server.

# Admin copilot (app/api/ai/copilot). Optional: without a key the copilot uses its rule-based answers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Tried in order if the primary model is down, rate-limited or refuses (comma-separated; empty = no fallbacks).
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-5.5,google/gemini-3.8-flash
